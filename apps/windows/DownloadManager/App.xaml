<Application x:Class="DownloadManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Palette from the design mock-up -->
      <Color x:Key="CyanColor">#FF00F2FE</Color>
      <Color x:Key="BlueColor">#FF4FACFE</Color>
      <Color x:Key="PurpleColor">#FF7928CA</Color>
      <Color x:Key="EmeraldColor">#FF00F5A0</Color>
      <Color x:Key="AmberColor">#FFFFB300</Color>
      <Color x:Key="RoseColor">#FFFF5C7A</Color>

      <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
      <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
      <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />
      <SolidColorBrush x:Key="EmeraldBrush" Color="{StaticResource EmeraldColor}" />
      <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
      <SolidColorBrush x:Key="RoseBrush" Color="{StaticResource RoseColor}" />

      <SolidColorBrush x:Key="WindowTintBrush" Color="#D90D0F17" />
      <SolidColorBrush x:Key="BarBrush" Color="#66000000" />
      <SolidColorBrush x:Key="PanelBrush" Color="#0DFFFFFF" />
      <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="DimTextBrush" Color="#FF9AA0B4" />
      <SolidColorBrush x:Key="FaintTextBrush" Color="#FF6B7186" />
      <SolidColorBrush x:Key="CyanTintBrush" Color="#1A00F2FE" />
      <SolidColorBrush x:Key="CyanLineBrush" Color="#3300F2FE" />

      <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#FF06B6D4" Offset="0" />
        <GradientStop Color="#FF2563EB" Offset="0.55" />
        <GradientStop Color="#FF7928CA" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF06B6D4" Offset="0" />
        <GradientStop Color="#FF2563EB" Offset="0.6" />
        <GradientStop Color="#FF4F46E5" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="PrimaryGradientHover" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF22D3EE" Offset="0" />
        <GradientStop Color="#FF3B82F6" Offset="0.6" />
        <GradientStop Color="#FF6366F1" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="SpeedGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF00F2FE" Offset="0" />
        <GradientStop Color="#FF4FACFE" Offset="0.5" />
        <GradientStop Color="#FF00F5A0" Offset="1" />
      </LinearGradientBrush>

      <!-- Ribbon / toolbar button -->
      <Style x:Key="RibbonButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="12" />
      </Style>

      <!-- Primary (gradient) button; the gradient is kept on hover/press by overriding the theme brushes -->
      <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource RibbonButton}">
        <Setter Property="Background" Value="{StaticResource PrimaryGradient}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,6" />
        
      </Style>

      <!-- Small square icon button used in list rows -->
      <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource RibbonButton}">
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>

      <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
      </Style>

      <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas" />
        <Setter Property="FontSize" Value="11" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
