<ContentDialog x:Class="DownloadManager.AddDownloadDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                RequestedTheme="Dark"
                Title="Add download"
                PrimaryButtonText="Download now"
                SecondaryButtonText="Add to queue"
                CloseButtonText="Cancel"
                DefaultButton="Primary"
                IsPrimaryButtonEnabled="False"
                IsSecondaryButtonEnabled="False">
  <StackPanel Spacing="14" MinWidth="460">
    <StackPanel Spacing="6">
      <Grid>
        <TextBlock Text="Link (HTTP, HTTPS or FTP)" Foreground="{StaticResource CyanBrush}" FontSize="12" />
        <TextBlock x:Name="ClipboardHint" Text="Link taken from clipboard" HorizontalAlignment="Right"
                   Foreground="{StaticResource EmeraldBrush}" FontSize="11" Visibility="Collapsed" />
      </Grid>
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="UrlBox" PlaceholderText="https://example.com/file.zip" TextChanged="UrlBox_TextChanged" />
        <Button Grid.Column="1" Content="Paste" Click="Paste_Click" />
      </Grid>
      <TextBlock x:Name="UrlError" Foreground="{StaticResource RoseBrush}" FontSize="11" Visibility="Collapsed" />
    </StackPanel>

    <!-- Video / audio from websites (YouTube, Instagram, ...) -->
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="8" Padding="12">
      <StackPanel Spacing="8">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE714;" FontSize="14" Foreground="{StaticResource RoseBrush}" />
            <TextBlock Text="Video or audio from a website" VerticalAlignment="Center" />
          </StackPanel>
          <Button x:Name="FindVideoButton" Grid.Column="1" Content="Find video" Click="FindVideo_Click" IsEnabled="False"
                  AutomationProperties.Name="Find video" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ProgressRing x:Name="VideoRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
          <TextBlock x:Name="VideoStatus" FontSize="12" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" MaxWidth="420" />
        </StackPanel>
        <Button x:Name="InstallToolsButton" Content="Install video tools" Click="InstallTools_Click" Visibility="Collapsed"
                AutomationProperties.Name="Install video tools" />
        <ComboBox x:Name="QualityBox" Header="Quality" HorizontalAlignment="Stretch" Visibility="Collapsed"
                  AutomationProperties.Name="Quality" />
      </StackPanel>
    </Border>

    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ComboBox x:Name="CategoryBox" Header="Category" HorizontalAlignment="Stretch" />
      <TextBox x:Name="FolderBox" Grid.Column="1" Header="Save to (blank = by category)" PlaceholderText="Default folder" />
    </Grid>
    <Button Content="Browse for folder…" Click="Browse_Click" HorizontalAlignment="Right" />

    <Expander Header="Authentication and cookies" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="8">
        <TextBox x:Name="AuthBox" PlaceholderText="Authorization header (for example: Bearer abc123)" />
        <TextBox x:Name="CookieBox" PlaceholderText="Cookie header" />
      </StackPanel>
    </Expander>
  </StackPanel>
</ContentDialog>
