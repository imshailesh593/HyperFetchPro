<ContentDialog x:Class="DownloadManager.SchedulerDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                RequestedTheme="Dark"
                Title="Scheduler"
                CloseButtonText="Close"
                DefaultButton="Close">
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
    <x:Double x:Key="ContentDialogMinWidth">700</x:Double>
  </ContentDialog.Resources>
  <Grid ColumnSpacing="16" MinWidth="680" Height="470">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="190" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Queue list -->
    <Grid RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ListView x:Name="QueueList" SelectionChanged="Queue_SelectionChanged" SelectionMode="Single"
                AutomationProperties.Name="Queues" />
      <StackPanel Grid.Row="1" Spacing="6">
        <Button Content="New queue" HorizontalAlignment="Stretch" AutomationProperties.Name="New queue">
          <Button.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem Text="Download queue" Click="NewDownloadQueue_Click" />
              <MenuFlyoutItem Text="Synchronization queue" Click="NewSyncQueue_Click" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button x:Name="DeleteButton" Content="Delete queue" HorizontalAlignment="Stretch" Click="Delete_Click"
                AutomationProperties.Name="Delete queue" />
      </StackPanel>
    </Grid>

    <!-- Editor -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Editor" Spacing="12" Padding="0,0,12,0">
        <TextBox x:Name="NameBox" Header="Name" AutomationProperties.Name="Queue name" />
        <TextBlock x:Name="KindText" FontSize="11" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" />

        <NumberBox x:Name="ParBox" Header="Files downloaded at the same time" Minimum="1" Maximum="10"
                   SpinButtonPlacementMode="Inline" SmallChange="1" AutomationProperties.Name="Parallel downloads" />

        <StackPanel Spacing="6">
          <TextBlock Text="SCHEDULE" Style="{StaticResource SectionLabel}" />
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
              <CheckBox x:Name="StartCheck" Content="Start at" AutomationProperties.Name="Start at" />
              <TimePicker x:Name="StartPicker" ClockIdentifier="24HourClock" MinuteIncrement="1"
                          IsEnabled="{Binding IsChecked, ElementName=StartCheck}" AutomationProperties.Name="Start time" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <CheckBox x:Name="StopCheck" Content="Stop at" AutomationProperties.Name="Stop at" />
              <TimePicker x:Name="StopPicker" ClockIdentifier="24HourClock" MinuteIncrement="1"
                          IsEnabled="{Binding IsChecked, ElementName=StopCheck}" AutomationProperties.Name="Stop time" />
            </StackPanel>
          </Grid>
          <TextBlock Text="On days" FontSize="12" />
          <StackPanel Orientation="Horizontal" Spacing="2">
            <CheckBox x:Name="DaySun" Content="Sun" MinWidth="0" />
            <CheckBox x:Name="DayMon" Content="Mon" MinWidth="0" />
            <CheckBox x:Name="DayTue" Content="Tue" MinWidth="0" />
            <CheckBox x:Name="DayWed" Content="Wed" MinWidth="0" />
            <CheckBox x:Name="DayThu" Content="Thu" MinWidth="0" />
            <CheckBox x:Name="DayFri" Content="Fri" MinWidth="0" />
            <CheckBox x:Name="DaySat" Content="Sat" MinWidth="0" />
          </StackPanel>
          <TextBlock x:Name="SyncHint" FontSize="11" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ComboBox x:Name="AfterBox" Header="When the queue finishes" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="When the queue finishes">
          <ComboBoxItem Content="Do nothing" />
          <ComboBoxItem Content="Exit the application" />
        </ComboBox>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="ApplyButton" Content="Apply" Click="Apply_Click" AutomationProperties.Name="Apply" />
          <Button x:Name="StartNowButton" Content="Start now" Click="StartNow_Click" AutomationProperties.Name="Start now" />
          <Button x:Name="StopNowButton" Content="Stop" Click="StopNow_Click" AutomationProperties.Name="Stop" />
        </StackPanel>
        <TextBlock x:Name="Status" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</ContentDialog>
