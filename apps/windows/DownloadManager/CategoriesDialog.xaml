<ContentDialog x:Class="DownloadManager.CategoriesDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                RequestedTheme="Dark"
                Title="Categories"
                CloseButtonText="Close"
                DefaultButton="Close">
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">780</x:Double>
    <x:Double x:Key="ContentDialogMinWidth">660</x:Double>
  </ContentDialog.Resources>
  <Grid ColumnSpacing="16" MinWidth="640" Height="380">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="190" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ListView x:Name="CategoryList" SelectionChanged="Category_SelectionChanged" SelectionMode="Single"
                AutomationProperties.Name="Categories" />
      <StackPanel Grid.Row="1" Spacing="6">
        <Button Content="New category" HorizontalAlignment="Stretch" Click="New_Click" AutomationProperties.Name="New category" />
        <Button x:Name="DeleteButton" Content="Delete category" HorizontalAlignment="Stretch" Click="Delete_Click"
                AutomationProperties.Name="Delete category" />
      </StackPanel>
    </Grid>

    <StackPanel x:Name="Editor" Grid.Column="1" Spacing="12">
      <TextBox x:Name="NameBox" Header="Name" AutomationProperties.Name="Category name" />
      <TextBox x:Name="ExtBox" Header="File types (extensions separated by spaces)" AcceptsReturn="True" TextWrapping="Wrap"
               Height="90" AutomationProperties.Name="File types" />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="FolderBox" Header="Save to (blank = a folder named after the category)" AutomationProperties.Name="Category folder" />
        <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="Browse_Click" />
      </Grid>
      <Button x:Name="SaveButton" Content="Save category" Click="Save_Click" AutomationProperties.Name="Save category" />
      <TextBlock x:Name="Status" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</ContentDialog>
