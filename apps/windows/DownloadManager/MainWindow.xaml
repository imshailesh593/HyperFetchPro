<Window x:Class="DownloadManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="using:DownloadManager.Models"
        xmlns:vm="using:DownloadManager.ViewModels"
        xmlns:svc="using:DownloadManager.Services"
        xmlns:ctl="using:DownloadManager.Controls"
        Title="Download Manager">
  <Window.SystemBackdrop>
    <DesktopAcrylicBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root" Background="{StaticResource WindowTintBrush}" RequestedTheme="Dark">
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>

    <!-- ================= Title bar ================= -->
    <Grid x:Name="TitleBarGrid" Background="{StaticResource BarBrush}" Padding="12,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="150" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Width="24" Height="24" CornerRadius="8" Background="{StaticResource BrandGradient}">
            <FontIcon Glyph="&#xE945;" FontSize="13" Foreground="White" />
          </Border>
          <TextBlock Text="Download Manager" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse x:Name="EngineDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource AmberBrush}" />
            <TextBlock Text="{x:Bind Vm.ConnectionText, Mode=OneWay}" Style="{StaticResource MonoText}"
                       Foreground="{StaticResource DimTextBrush}" />
          </StackPanel>
        </Border>

        <Button x:Name="TurboButton" Click="Turbo_Click" AutomationProperties.Name="Toggle turbo connections" Style="{StaticResource RibbonButton}" Padding="10,2"
                ToolTipService.ToolTip="Toggle 32 connections per download (default is 8)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE945;" FontSize="12" Foreground="{StaticResource AmberBrush}" />
            <TextBlock Text="{x:Bind Vm.TurboLabel, Mode=OneWay}" FontSize="11" />
          </StackPanel>
        </Button>
      </StackPanel>

      <TextBox x:Name="SearchBox" AutomationProperties.Name="Search downloads" Grid.Column="2" Width="320" Height="30" VerticalAlignment="Center"
               PlaceholderText="Search downloads and links…  (Ctrl+K)" TextChanged="Search_TextChanged" FontSize="12" />
    </Grid>

    <!-- ================= Command ribbon ================= -->
    <Grid Grid.Row="1" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource HairlineBrush}"
          BorderThickness="0,1,0,1" Padding="16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Click="Add_Click" AutomationProperties.Name="Add URL">
          <Button.Resources>
            <StaticResource x:Key="ButtonBackground" ResourceKey="PrimaryGradient" />
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="PrimaryGradientHover" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="PrimaryGradient" />
            <SolidColorBrush x:Key="ButtonForeground" Color="White" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
          </Button.Resources>
          <Button.KeyboardAccelerators>
            <KeyboardAccelerator Key="Insert" />
          </Button.KeyboardAccelerators>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE710;" FontSize="14" />
            <TextBlock Text="Add URL" />
            <Border Background="#4D000000" CornerRadius="3" Padding="4,0">
              <TextBlock Text="INS" FontSize="9" Style="{StaticResource MonoText}" />
            </Border>
          </StackPanel>
        </Button>

        <Button Style="{StaticResource RibbonButton}" IsEnabled="False"
                ToolTipService.ToolTip="Media sniffing arrives with the browser extension">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE7F7;" FontSize="13" Foreground="{StaticResource RoseBrush}" />
            <TextBlock Text="Stream Sniffer" />
          </StackPanel>
        </Button>

        <Rectangle Width="1" Height="18" Fill="{StaticResource HairlineBrush}" Margin="4,0" />

        <Button Style="{StaticResource RibbonButton}" Click="ResumeAll_Click" AutomationProperties.Name="Resume all">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{StaticResource EmeraldBrush}" />
            <TextBlock Text="Resume all" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource RibbonButton}" Click="PauseAll_Click" AutomationProperties.Name="Pause all">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE769;" FontSize="12" Foreground="{StaticResource AmberBrush}" />
            <TextBlock Text="Pause all" />
          </StackPanel>
        </Button>

        <Rectangle Width="1" Height="18" Fill="{StaticResource HairlineBrush}" Margin="4,0" />

        <Button Style="{StaticResource RibbonButton}" Click="StartQueue_Click" AutomationProperties.Name="Start queue"
                IsEnabled="{x:Bind svc:Ui.Not(Vm.QueueRunning), Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE71D;" FontSize="12" Foreground="{StaticResource CyanBrush}" />
            <TextBlock Text="Start queue" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource RibbonButton}" Click="StopQueue_Click" AutomationProperties.Name="Stop queue" IsEnabled="{x:Bind Vm.QueueRunning, Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="{StaticResource RoseBrush}" />
            <TextBlock Text="Stop queue" />
          </StackPanel>
        </Button>

        <Rectangle Width="1" Height="18" Fill="{StaticResource HairlineBrush}" Margin="4,0" />

        <Button Style="{StaticResource RibbonButton}" Click="Options_Click" AutomationProperties.Name="Options"
                ToolTipService.ToolTip="Options (Ctrl+,)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE713;" FontSize="12" Foreground="{StaticResource BlueBrush}" />
            <TextBlock Text="Options" />
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Right">
          <TextBlock Text="SPEED, LAST MINUTE" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
          <Canvas x:Name="SpeedCanvas" Width="130" Height="24" Background="#66000000" Margin="0,2,0,0">
            <Polygon x:Name="SpeedFill" Fill="#1F00F2FE" />
            <Polyline x:Name="SpeedLine" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.5" />
          </Canvas>
        </StackPanel>
        <Rectangle Width="1" Height="30" Fill="{StaticResource HairlineBrush}" />
        <StackPanel MinWidth="130">
          <TextBlock Text="TOTAL SPEED" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
            <TextBlock Text="{x:Bind Vm.TotalSpeedValue, Mode=OneWay}" FontSize="24" FontWeight="Black"
                       Foreground="{StaticResource SpeedGradient}" FontFamily="Cascadia Code, Consolas" />
            <TextBlock Text="{x:Bind Vm.TotalSpeedUnit, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource CyanBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- ================= Workspace ================= -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Grid Background="{StaticResource BarBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0" Padding="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
            <StackPanel>
              <TextBlock Text="TRANSFERS" Style="{StaticResource SectionLabel}" Margin="8,4" />
              <ListView x:Name="NavList" SelectionMode="Single" SelectionChanged="Nav_SelectionChanged" SelectedIndex="0">
                <ListViewItem Tag="all">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE81E;" FontSize="14" Foreground="{StaticResource CyanBrush}" />
                    <TextBlock Grid.Column="1" Text="All downloads" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Vm.CountAll, Mode=OneWay}" Style="{StaticResource MonoText}" Foreground="{StaticResource CyanBrush}" />
                  </Grid>
                </ListViewItem>
                <ListViewItem Tag="downloading">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{StaticResource CyanBrush}" />
                    <TextBlock Grid.Column="1" Text="Downloading" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Vm.CountDownloading, Mode=OneWay}" Style="{StaticResource MonoText}" Foreground="{StaticResource CyanBrush}" />
                  </Grid>
                </ListViewItem>
                <ListViewItem Tag="completed">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{StaticResource EmeraldBrush}" />
                    <TextBlock Grid.Column="1" Text="Completed" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Vm.CountCompleted, Mode=OneWay}" Style="{StaticResource MonoText}" Foreground="{StaticResource EmeraldBrush}" />
                  </Grid>
                </ListViewItem>
                <ListViewItem Tag="paused">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE769;" FontSize="14" Foreground="{StaticResource AmberBrush}" />
                    <TextBlock Grid.Column="1" Text="Paused / queued" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Vm.CountPaused, Mode=OneWay}" Style="{StaticResource MonoText}" Foreground="{StaticResource AmberBrush}" />
                  </Grid>
                </ListViewItem>
              </ListView>
            </StackPanel>

            <StackPanel>
              <TextBlock Text="CATEGORIES" Style="{StaticResource SectionLabel}" Margin="8,4" />
              <ListView x:Name="CategoryList" SelectionMode="Single" SelectionChanged="Category_SelectionChanged"
                        ItemsSource="{x:Bind Vm.Categories}">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="vm:CategoryEntry">
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{StaticResource BlueBrush}" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="12" />
                      <TextBlock Grid.Column="2" Text="{x:Bind Count, Mode=OneWay}" Style="{StaticResource MonoText}" Foreground="{StaticResource DimTextBrush}" />
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </StackPanel>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12">
              <StackPanel Spacing="6">
                <Grid>
                  <TextBlock Text="Speed limit" Style="{StaticResource MonoText}" />
                  <TextBlock Text="{x:Bind Vm.SpeedLimitText, Mode=OneWay}" Style="{StaticResource MonoText}"
                             Foreground="{StaticResource CyanBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                </Grid>
                <Slider x:Name="LimitSlider" Maximum="200" Minimum="10" Value="200" StepFrequency="5" SmallChange="5"
                        ValueChanged="Limit_ValueChanged" />
                <Grid>
                  <TextBlock Text="10 MB/s" FontSize="9" Style="{StaticResource MonoText}" Foreground="{StaticResource FaintTextBrush}" />
                  <TextBlock Text="No limit" FontSize="9" Style="{StaticResource MonoText}" Foreground="{StaticResource FaintTextBrush}" HorizontalAlignment="Right" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                CornerRadius="10" Padding="10" Margin="0,10,0,0">
          <StackPanel Spacing="6">
            <Grid>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xEDA2;" FontSize="13" Foreground="{StaticResource PurpleBrush}" />
                <TextBlock x:Name="DriveName" Text="Drive" FontSize="11" />
              </StackPanel>
              <TextBlock x:Name="DriveFree" Style="{StaticResource MonoText}" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Right" />
            </Grid>
            <ProgressBar x:Name="DriveBar" Minimum="0" Maximum="100" Height="4" Foreground="{StaticResource CyanBrush}" />
            <TextBlock x:Name="DriveFolder" Style="{StaticResource MonoText}" FontSize="9" Foreground="{StaticResource FaintTextBrush}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Downloads -->
      <Grid Grid.Column="1" Background="#33000000">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="ColumnHeader" Padding="16,9" Background="{StaticResource BarBrush}"
              BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1.3*" />
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.3*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="FILE" Style="{StaticResource SectionLabel}" />
          <TextBlock Grid.Column="1" Text="PROGRESS" Style="{StaticResource SectionLabel}" />
          <TextBlock Grid.Column="2" Text="SIZE" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="3" Text="SPEED" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="4" Text="ETA" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="5" Text="" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
        </Grid>

        <ListView x:Name="DownloadList" Grid.Row="1" ItemsSource="{x:Bind Vm.Visible}" SelectionMode="Single"
                  SelectionChanged="Downloads_SelectionChanged" DoubleTapped="Downloads_DoubleTapped"
                  IsItemClickEnabled="False">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="16,10" />
              <Setter Property="MinHeight" Value="0" />
              <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
              <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="d:DownloadItem">
              <Grid ColumnSpacing="8">
                <Grid.ContextFlyout>
                  <MenuFlyout Opening="RowMenu_Opening">
                    <MenuFlyoutItem Text="Pause" Tag="{x:Bind}" Click="Row_Pause" Icon="Pause" />
                    <MenuFlyoutItem Text="Resume" Tag="{x:Bind}" Click="Row_Resume" Icon="Play" />
                    <MenuFlyoutItem Text="Show connection details" Tag="{x:Bind}" Click="Row_Inspect" Icon="View" />
                    <MenuFlyoutItem Text="Show in Explorer" Tag="{x:Bind}" Click="Row_Explorer" Icon="OpenLocal" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Copy link" Tag="{x:Bind}" Click="Row_CopyLink" Icon="Copy" />
                    <MenuFlyoutItem Text="Copy as curl command" Tag="{x:Bind}" Click="Row_CopyCurl" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Remove from list" Tag="{x:Bind}" Click="Row_Remove" Icon="Delete" />
                    <MenuFlyoutItem Text="Remove and delete files" Tag="{x:Bind}" Click="Row_RemoveFiles" Icon="Delete" />
                  </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="4*" />
                  <ColumnDefinition Width="4*" />
                  <ColumnDefinition Width="1.2*" />
                  <ColumnDefinition Width="1.3*" />
                  <ColumnDefinition Width="1.1*" />
                  <ColumnDefinition Width="1.3*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <Border Width="36" Height="36" CornerRadius="10" Background="#66000000" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                    <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}" FontSize="16" Foreground="{x:Bind IconBrush, Mode=OneWay}" />
                  </Border>
                  <StackPanel VerticalAlignment="Center" MaxWidth="280">
                    <TextBlock Text="{x:Bind Filename, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="10" Style="{StaticResource MonoText}" Foreground="{StaticResource DimTextBrush}" TextTrimming="CharacterEllipsis">
                      <Run Text="{x:Bind Domain, Mode=OneWay}" Foreground="{StaticResource CyanBrush}" />
                      <Run Text=" • " />
                      <Run Text="{x:Bind CategoryName, Mode=OneWay}" />
                      <Run Text="{x:Bind ConnectionsText, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Padding="0,0,12,0">
                  <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border CornerRadius="10" Padding="8,1" Background="#1A808080" BorderBrush="{x:Bind StatusBrush, Mode=OneWay}" BorderThickness="1">
                        <TextBlock Text="{x:Bind PercentText, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                   Style="{StaticResource MonoText}" />
                      </Border>
                      <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" FontSize="10" Style="{StaticResource MonoText}" Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="10" Style="{StaticResource MonoText}"
                               Foreground="{x:Bind StatusBrush, Mode=OneWay}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                  </Grid>
                  <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" Maximum="100" Height="3" Foreground="{StaticResource CyanBrush}" />
                  <ctl:SegmentStrip Buckets="{x:Bind Buckets, Mode=OneWay}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MonoText}" />
                <TextBlock Grid.Column="3" Text="{x:Bind SpeedText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Style="{StaticResource MonoText}" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" />
                <TextBlock Grid.Column="4" Text="{x:Bind EtaText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Style="{StaticResource MonoText}" Foreground="{StaticResource DimTextBrush}" />

                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Button Style="{StaticResource RowIconButton}" Tag="{x:Bind}" Click="Row_Pause" ToolTipService.ToolTip="Pause"
                          Visibility="{x:Bind svc:Ui.Vis(CanPause), Mode=OneWay}">
                    <FontIcon Glyph="&#xE769;" FontSize="12" Foreground="{StaticResource AmberBrush}" />
                  </Button>
                  <Button Style="{StaticResource RowIconButton}" Tag="{x:Bind}" Click="Row_Resume" ToolTipService.ToolTip="Resume"
                          Visibility="{x:Bind svc:Ui.Vis(CanResume), Mode=OneWay}">
                    <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{StaticResource CyanBrush}" />
                  </Button>
                  <Button Style="{StaticResource RowIconButton}" Tag="{x:Bind}" Click="Row_Explorer" ToolTipService.ToolTip="Show in folder"
                          Visibility="{x:Bind svc:Ui.Vis(IsCompleted), Mode=OneWay}">
                    <FontIcon Glyph="&#xE838;" FontSize="12" Foreground="{StaticResource EmeraldBrush}" />
                  </Button>
                  <Button Style="{StaticResource RowIconButton}" Tag="{x:Bind}" Click="Row_Inspect" ToolTipService.ToolTip="Connection details">
                    <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="{StaticResource DimTextBrush}" />
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsHitTestVisible="False"
                    Visibility="{x:Bind svc:Ui.VisIfEmpty(Vm.Visible.Count), Mode=OneWay}">
          <FontIcon Glyph="&#xE896;" FontSize="44" Foreground="{StaticResource CyanLineBrush}" />
          <TextBlock x:Name="EmptyText" Text="No downloads here yet. Press Insert to add a link." Foreground="{StaticResource FaintTextBrush}"
                     Style="{StaticResource MonoText}" />
        </StackPanel>

        <!-- Details drawer -->
        <Grid x:Name="Drawer" Grid.Row="1" VerticalAlignment="Bottom" Height="270" Visibility="Collapsed"
              Background="#F20A0C14" BorderBrush="{StaticResource CyanLineBrush}" BorderThickness="0,1,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Background="#80000000" Padding="16,0,8,0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="{StaticResource CyanBrush}" />
              <TextBlock Text="CONNECTION DETAILS" Style="{StaticResource SectionLabel}" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" />
              <TextBlock x:Name="DrawerTitle" Style="{StaticResource MonoText}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource RowIconButton}" HorizontalAlignment="Right" Click="CloseDrawer_Click" Background="Transparent" BorderThickness="0">
              <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
          </Grid>

          <Grid Grid.Row="1" Padding="16,12" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="5*" />
              <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="6">
              <Grid>
                <TextBlock Text="LIVE CONNECTIONS" Style="{StaticResource SectionLabel}" />
                <TextBlock x:Name="DrawerConnCount" Style="{StaticResource MonoText}" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Right" />
              </Grid>
              <ScrollViewer Height="170">
                <ItemsControl x:Name="SegmentList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="d:SegmentDto">
                      <Grid Margin="0,2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="150" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind RangeText}" Style="{StaticResource MonoText}" FontSize="10" Foreground="{StaticResource DimTextBrush}" />
                        <ProgressBar Grid.Column="1" Value="{x:Bind Percent}" Maximum="100" Height="4" VerticalAlignment="Center" Foreground="{StaticResource CyanBrush}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind WrittenText}" Style="{StaticResource MonoText}" FontSize="10" HorizontalAlignment="Right" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="SOURCE" Style="{StaticResource SectionLabel}" />
              <TextBox x:Name="DrawerUrl" IsReadOnly="True" FontSize="11" FontFamily="Cascadia Code, Consolas" />
              <TextBlock x:Name="DrawerInfo" Style="{StaticResource MonoText}" FontSize="10" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" />
              <TextBlock x:Name="DrawerError" Style="{StaticResource MonoText}" FontSize="10" Foreground="{StaticResource RoseBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- ================= Status bar ================= -->
    <Grid Grid.Row="3" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="12,0">
      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource DimTextBrush}">
          <Run Text="Active connections:" />
          <Run Text="{x:Bind Vm.ActiveConnections, Mode=OneWay}" Foreground="White" FontWeight="Bold" />
        </TextBlock>
        <TextBlock Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource DimTextBrush}">
          <Run Text="Max per download:" />
          <Run Text="{x:Bind Vm.MaxConnections, Mode=OneWay}" Foreground="White" FontWeight="Bold" />
        </TextBlock>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Right">
        <TextBlock Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource DimTextBrush}">
          <Run Text="Disk write:" />
          <Run Text="{x:Bind Vm.TotalSpeedValue, Mode=OneWay}" Foreground="{StaticResource EmeraldBrush}" FontWeight="Bold" />
          <Run Text="{x:Bind Vm.TotalSpeedUnit, Mode=OneWay}" Foreground="{StaticResource EmeraldBrush}" />
        </TextBlock>
        <TextBlock Text="Browser extension: not installed" Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource FaintTextBrush}" />
      </StackPanel>
    </Grid>

    <!-- Toasts -->
    <StackPanel x:Name="ToastHost" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" Spacing="8" />
  </Grid>
</Window>
