<ContentDialog x:Class="DownloadManager.SettingsDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                RequestedTheme="Dark"
                Title="Options"
                PrimaryButtonText="Save"
                CloseButtonText="Cancel"
                DefaultButton="Primary">
  <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" MinWidth="460" Padding="0,0,12,0">

      <StackPanel Spacing="6">
        <TextBlock Text="DOWNLOADS" Style="{StaticResource SectionLabel}" />
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="FolderBox" Header="Default download folder" AutomationProperties.Name="Default download folder"
                   TextChanged="Folder_TextChanged" />
          <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="Browse_Click" />
        </Grid>
        <TextBlock x:Name="FolderError" Foreground="{StaticResource RoseBrush}" FontSize="11" Visibility="Collapsed" />
        <TextBlock Text="Files go into a subfolder by category (Video, Music, …) unless you pick a folder when adding."
                   FontSize="11" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" />
      </StackPanel>

      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <NumberBox x:Name="ConnBox" Header="Connections per download" SpinButtonPlacementMode="Inline"
                     Minimum="1" Maximum="32" SmallChange="1" AutomationProperties.Name="Connections per download" />
          <TextBlock Text="More can be faster, but some servers limit them. Applies to new downloads."
                     FontSize="11" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <NumberBox x:Name="SpeedBox" Header="Speed limit (MB/s, 0 = unlimited)" SpinButtonPlacementMode="Inline"
                     Minimum="0" Maximum="1000" SmallChange="1" AutomationProperties.Name="Speed limit" />
          <TextBlock Text="Total across all running downloads."
                     FontSize="11" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <StackPanel Spacing="6">
        <TextBlock Text="DOWNLOAD LIMIT" Style="{StaticResource SectionLabel}" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <NumberBox x:Name="QuotaMbBox" Header="Maximum amount (MB, 0 = off)" SpinButtonPlacementMode="Inline"
                     Minimum="0" Maximum="10000000" SmallChange="10" AutomationProperties.Name="Download limit amount" />
          <NumberBox x:Name="QuotaHoursBox" Grid.Column="1" Header="Per period (hours)" SpinButtonPlacementMode="Inline"
                     Minimum="0.1" Maximum="720" SmallChange="0.5" AutomationProperties.Name="Download limit period" />
        </Grid>
        <TextBlock Text="For connections with a fair-use cap: downloads pause when the amount is used up and continue by themselves when the period ends."
                   FontSize="11" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="VIDEO TOOLS" Style="{StaticResource SectionLabel}" />
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12">
          <StackPanel Spacing="8">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="YtDlpText" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button x:Name="YtDlpButton" Grid.Column="1" Click="YtDlp_Click" AutomationProperties.Name="Install or update yt-dlp" />
            </Grid>
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="FfmpegText" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button x:Name="FfmpegButton" Grid.Column="1" Content="Install ffmpeg" Click="Ffmpeg_Click" Visibility="Collapsed"
                      AutomationProperties.Name="Install ffmpeg" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ProgressRing x:Name="ToolRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
              <TextBlock x:Name="ToolStatus" FontSize="12" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" MaxWidth="400" />
            </StackPanel>
            <CheckBox x:Name="AutoUpdateBox" Content="Keep yt-dlp up to date automatically" AutomationProperties.Name="Keep yt-dlp up to date automatically" />
            <TextBlock Text="With automatic updates the app checks once a day (only when no video is downloading) and installs a newer official release when there is one. Downloads come from github.com/yt-dlp and are checked against published checksums."
                       FontSize="11" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="DATA" Style="{StaticResource SectionLabel}" />
        <TextBlock x:Name="DataText" FontSize="11" Foreground="{StaticResource DimTextBrush}" IsTextSelectionEnabled="True"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</ContentDialog>
