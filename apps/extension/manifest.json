{
  "manifest_version": 3,
  "name": "Download Manager Integration",
  "version": "0.1.0",
  "description": "Sends browser downloads to the Download Manager desktop app.",
  "minimum_chrome_version": "110",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "cookies",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Download Manager",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "key": ""
}
